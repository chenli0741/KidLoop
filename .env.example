DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Private Vercel Blob store for student photos
BLOB_READ_WRITE_TOKEN=

# Server-only natural-language scheduling (choose a Structured Outputs compatible model)
OPENAI_API_KEY=
OPENAI_RESCHEDULING_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional JSON keyed by model: input/cachedInput/output USD per million tokens, source URL, date
OPENAI_PRICE_TABLE={}

# Connected Gmail module: one platform OAuth client; each company connects its own mailbox.
# Server-only. Never use NEXT_PUBLIC_ for these values.
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters. Keep stable and back up securely.
MAIL_TOKEN_ENCRYPTION_KEY=
# Register this origin + /api/mail/google/callback as an authorized redirect URI in Google.
KIDLOOP_APP_URL=https://kid-loop.vercel.app
