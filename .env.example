DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Private Vercel Blob store for student photos
BLOB_READ_WRITE_TOKEN=

# Server-only natural-language scheduling (choose a Structured Outputs compatible model)
OPENAI_API_KEY=
OPENAI_RESCHEDULING_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional JSON keyed by model: input/cachedInput/output USD per million tokens, source URL, date
OPENAI_PRICE_TABLE={}

# Platform-wide invitation email service (server-only; never NEXT_PUBLIC_*)
KIDLOOP_MAIL_PROVIDER=resend
RESEND_API_KEY=
# Use a sender on a verified domain, e.g. KidLoop <invitations@example.com>
KIDLOOP_MAIL_FROM=
# Canonical HTTPS application URL; invitation links never use request Host headers
KIDLOOP_APP_URL=https://kid-loop.vercel.app
