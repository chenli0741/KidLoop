{
  "name": "kidloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "ios:sync": "node scripts/sync-ios.mjs",
    "ios:open": "open ios/App/KidLoop.xcodeproj",
    "auth:create-admin": "node --env-file=.env.local --import tsx scripts/create-admin.ts",
    "test:roles": "node --conditions=react-server --import tsx --test tests/roles.test.ts",
    "test:profiles": "node --conditions=react-server --import tsx --test tests/profile.test.ts",
    "test:pickup": "node --conditions=react-server --import tsx --test tests/pickup-settings.test.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
